# AgentCore 生产环境变量模板
#
# 用法：在服务器复制为 deploy/config/production.env（已被 .gitignore 忽略，含真实密钥），
# 填好后由 compose 与应用共用：
#   docker compose -f deploy/docker-compose.server.yml --env-file deploy/config/production.env up -d
#   后端（宿主机 uv/systemd）从同一文件加载（或软链到 apps/server/.env）。
#
# ⚠️ 切勿提交真实密钥；所有 CHANGE_ME 占位值上线前必须替换为强随机值。

# ── Compose 基础设施密钥（被 docker-compose.server.yml 插值）──
POSTGRES_PASSWORD=CHANGE_ME_pg_password
REDIS_PASSWORD=CHANGE_ME_redis_password

# ── 应用镜像（被 docker-compose.app.yml 插值；CI 构建推 ACR，部署脚本设 IMAGE_TAG=<sha>）──
# IMAGE_REGISTRY 含命名空间，结合 image: ${IMAGE_REGISTRY}/api:${IMAGE_TAG}。
# 占位示例；生产填真实 ACR/镜像仓库（如 registry.example.com/your-namespace）。
IMAGE_REGISTRY=registry.example.com/your-namespace
IMAGE_TAG=latest
# ACR 登录凭据仅 deploy-server.sh 用（compose 不读）；可改放 $AGENTCORE_HOME/.env。
# ACR_USERNAME=CHANGE_ME
# ACR_PASSWORD=CHANGE_ME

# ── Database / Redis（应用连接串，密码需与上面一致；绑 127.0.0.1）──
DATABASE_URL=postgresql+asyncpg://agentcore:CHANGE_ME_pg_password@127.0.0.1:5432/agentcore
REDIS_URL=redis://:CHANGE_ME_redis_password@127.0.0.1:6379/0

# ── 计费形态 + 平台 LLM 上游（成本配额与计费.md §〇·六）──
# 目标形态：BILLING_MODE=platform（全员代付 · ¥10/月配额组）。dev / 本地默认仍 byok。
# 现网可临时切 byok 休眠平台代付（无 Key → 402）；再开 = 改回 platform 并重启 api。
BILLING_MODE=platform
# 平台上游（中转或 DeepSeek 官方根 URL）。platform 模式下必填有效 PLATFORM_API_KEY。
PLATFORM_API_KEY=CHANGE_ME
PLATFORM_BASE_URL=https://api.deepseek.com
# 账号默认 / 逻辑默认系统预置 = PLATFORM_MODEL（须有 curated 价卡，且 ∈ PLATFORM_MODELS）。
PLATFORM_MODEL=glm-5.2
# 平台模型目录 allowlist（逗号分隔）= 目录行 + 系统预置投影源。
# 空 = 回落 [PLATFORM_MODEL, PLATFORM_BACKGROUND_MODEL]（无 membership 冲突校验）。
# 非空时 PLATFORM_MODEL 与（若配置）PLATFORM_BACKGROUND_MODEL 必须 ∈ 本列表，否则**启动失败**。
# 列表内无 curated 价卡的 id → 不上架（不进目录 / 不生成系统预置）。
PLATFORM_MODELS=glm-5.2,deepseek-v4-flash
# 一 key 一模型覆盖（JSON）；空 = 全走 PLATFORM_API_KEY。
# PLATFORM_MODEL_CREDENTIALS=

# ── 配额默认（nano-CNY 台账；无 FREE_TIER / QUOTA_*_USD）──
QUOTA_DAILY_TOKENS=0
QUOTA_MONTHLY_COST_CNY=10
QUOTA_DAILY_COST_CNY=10
QUOTA_DAILY_REQUESTS=500

# ── BYOK 凭据加密主密钥（AES-256-GCM, 64 hex = 32 字节）──
# 加密用户自带 API Key 后落库（security.py KeyEncryptor）。
# billing_mode=byok 下为**必填**；platform 下 BYOK 为高级选项，仍建议配置以便用户绑自有 key。
# （服务仍能启动，但模型配置页报「未配置加密主密钥」——boots green 却功能死）。
# 生成：python -c "import secrets; print(secrets.token_hex(32))"
# ⚠️ 一经启用切勿更换——换 key 会使所有已存 Key 无法解密。
ENCRYPTION_KEY=CHANGE_ME_64_hex_chars

# ── Web search（SearXNG 主搜 + 可选 Tavily 备腿）──
# 宿主机 API → 默认与 config/search.py / .env.example 一致：http://localhost:18888
# （compose 将 SearXNG 绑在本机 18888→容器 8080）。API 进同一 compose 网络时改
# http://searxng:8080。api 不 depends_on searxng：未就绪则启动 probe 降级，web_search 暂不可用。
SEARXNG_URL=http://localhost:18888
# 生产建议配备用：SearXNG 主失败（熔断 / 传输 / 持续 5xx）时 web_search 再试一次 Tavily。
# 空 = 无备腿（纯 SearXNG）。密钥 https://tavily.com ；勿把占位提交进仓。
# TAVILY_API_KEY=
# TAVILY_BASE_URL=https://api.tavily.com

# ── JWT / Auth ──
JWT_SECRET_KEY=CHANGE_ME_to_a_long_random_secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Sliding window (tokens rotate + re-stamp expiry on every use): max idle gap
# before a forced re-login. 30d so users aren't bounced to login after a break.
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
INFERENCE_TOKEN_EXPIRE_MINUTES=120
INFERENCE_TOKEN_MINT_MAX=10
INFERENCE_TOKEN_MINT_WINDOW_SECONDS=60

# CSRF is a signed cookie (no Redis store). RATE_LIMIT_BACKEND=redis shares limiters
# across workers and unlocks WEB_CONCURRENCY / UVICORN_WORKERS / AGENTCORE_API_WORKERS > 1
# (memory + multi-worker is refused at boot). Cost ledger uses shared Postgres
# cost_ledger_outbox. Other bits (approval / IM / steer / journal) may still assume
# one process — see 部署拓扑 G5. Default stays workers=1; try e.g. WEB_CONCURRENCY=2
# only with redis (already set below).
CSRF_ENABLED=true
RATE_LIMIT_BACKEND=redis
# WEB_CONCURRENCY=2
TRUST_PROXY=true

# Public registration (开放注册). Set false to emergency-close signups.
REGISTRATION_OPEN=true

# ── 云端代码执行（gVisor，安全权限与治理.md §五 / 部署拓扑与环境.md §云端执行）──
# 【默认开】代码默认 gvisor_enabled=true；deploy/finish 默认叠 sandbox compose。
# 部署 AI **不必**再决定「开不开」——缺省即有云执行面。
# 紧急关闭：下行改 false 后 finish-server（健康探测失败时也会诚实不装配）。
# 开启前置：镜像内已装 runsc；叠 docker-compose.sandbox.yml（容器权限 + 内存余量）。
# 开启后云端 worker 注册 code_execute/test_run，执行免审批（AUTO_PASS，真隔离）。
# runsc 缺失 / 沙箱不健康 → 不拒启，打 sandbox.cloud_health_failed，执行类不装配。
GVISOR_ENABLED=true
# GVISOR_RUNSC_PATH=runsc
# runsc 状态目录须在 DATA_DIR 卷上（勿用 /tmp——容器 overlay 上 mkdir 会 EINVAL）。
# compose.app 已默认注入 /data/sandbox；非容器或自定义卷时显式设置：
# GVISOR_RUNTIME_ROOT=/data/sandbox
# 护栏（2C8G 单机起步值；按真实负载调）：
#   并发上限 + 有界等待（排队最多 N 秒，超时快速失败并向模型解释「执行位已满」）
# GVISOR_MAX_CONCURRENT_EXECUTIONS=2
# GVISOR_SLOT_WAIT_SECONDS=15
#   单次执行硬顶：内存（OCI cgroup）与时长（超时杀进程、不写回产物）
# GVISOR_MEMORY_LIMIT_MB=512
# 代码默认 630（≥ 外环 test_run 600s + slack）。勿照抄 60——会夹死外环 verify。
# GVISOR_TIMEOUT_MAX_SECONDS=630
#   产物写回（copy-in/copy-out）限额：载入沙箱的工作区体积 / 写回产物总量与文件数
# GVISOR_STAGE_MAX_BYTES=536870912
# GVISOR_WRITE_BACK_MAX_BYTES=134217728
# GVISOR_WRITE_BACK_MAX_FILES=200

# 无 gVisor 的裸 subprocess 云执行逃生口：保持关闭（等于容器内 RCE，见 SEC-005）。
# CODE_EXECUTE_CLOUD_ENABLED=false
# 装包（test_run install）另需宿主 netns/registry_egress；仅健康探测够跑 code_execute，
# ≠ package_install 已装配。能力行拆 code_execute= / package_install=。
# 桌面端打包后 renderer 的 origin = app://agentcore（前端技术与架构.md §7.2）。
# 手机网页版（Cloudflare Pages 等）：https://m.example.com（bearer 鉴权，仍须 allow-list）。
# Capacitor 安卓壳 WebView origin = https://localhost（另保留 capacitor://localhost / http://localhost）。
# 管理后台（独立 origin）：按实际部署追加，如 https://office.example.com。
CORS_ALLOW_ORIGINS=app://agentcore,https://m.example.com,https://office.example.com,https://localhost,capacitor://localhost,http://localhost

# ── Cookie（生产强制 HTTPS）──
# 桌面端 renderer（app://agentcore）与本 API 跨站，cookie 必须 SameSite=None + Secure
# 才会随凭据跨源请求发送；两者缺一桌面端登录会静默失败（启动期 fail-closed 校验）。
COOKIE_SECURE=true
COOKIE_SAMESITE=none
# API 经 Nginx 反代挂在 /api/ 下（app.example.com/api → :8000），故 refresh cookie 的
# path 必须带上该前缀，否则浏览器按 RFC 6265 不会把 cookie 发往 /api/v1/auth/refresh →
# 刷新静默失败、access 一过期即掉登录。须与 Nginx location 前缀一致；dev 留空（API 在根）。
COOKIE_PATH_PREFIX=/api

# ── Server ──
HOST=0.0.0.0
PORT=8000
DEBUG=false
# Structured event log (JSONL): omit or leave empty → stdout only (no file).
# Set to enable the file sink — scripts/log_stats.py + log sync rely on it.
LOG_FILE=logs/prod.jsonl

# ── 构建溯源（由发布流水线/部署脚本注入，经 GET /version 暴露）──
# 一般由部署脚本自动写入当前 git SHA 与构建时间，无需手填；缺省时 /version 回 "unknown"。
# GIT_SHA=<deploy 时注入的 git sha>
# BUILT_AT=<deploy 时注入的 ISO8601 时间>


# ── 服务端数据目录（MVP 长期记忆文件等）──
# 宿主机直跑 uv/systemd 时用此路径；容器化部署下 docker-compose.app.yml 会把
# 它覆盖为容器内 /data（挂 appdata 卷），此值仅对非容器运行生效。
DATA_DIR=/opt/agentcore/data

# ── 可观测 · 健康巡检告警（部署与运维.md §7.8）──
# 巡检 timer（deploy/systemd/agentcore-healthcheck.*）轮询 /readyz，连续失败推飞书。
# ⚠️ 此项由 healthcheck.sh 从 $AGENTCORE_HOME/.env（即 /opt/agentcore/.env）读取，
# **不走 compose / 不被应用读**——请写进那个运维级 .env，而非本 app 模板。
# 未配则降级 journald（journalctl -u agentcore-healthcheck.service）。
# ALERT_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/CHANGE_ME
# ALERT_KEYWORD=AgentCore          # 飞书机器人「自定义关键词」安全模式需与此一致

# ── Admin MFA（TOTP）──
# true = 管理后台强制双因素认证；false = 仅密码登录（会话隔离仍生效，admin 不能登桌面）。
# 内测/个人运维可暂设 false，对外运营前改回 true。
ADMIN_MFA_REQUIRED=true

# ── AI Town / 恋综模拟（开发默认 True；生产须显式关闭，避免误开 REST）──
SIMULATION_ENABLED=false

# ── 桌面自动更新（发布与门禁.md §7.6）──
# 熔断：DESKTOP_UPDATES_ENABLED=false 暂停下载坏版本（客户端 fail-open）。
# 硬地板：DESKTOP_MIN_VERSION 经 GET /updates/policy.min_desktop_version 下发，
# 且服务端对 X-Client-Platform=desktop 且版本更旧的 /v1/* 返回 426 CLIENT_TOO_OLD。
# 空 = 不拦（dev 友好）。生产建议地板 0.6.25。
# DESKTOP_UPDATES_ENABLED=true
# DESKTOP_MIN_VERSION=0.6.25
