{
  "name": "agentcore",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "conformance": "pnpm -r run conformance",
    "gen:types": "node scripts/gen-types.mjs",
    "bump-version": "node scripts/bump-version.mjs",
    "test:server": "cd apps/server && uv run pytest --tb=short -q",
    "test:server:unit": "cd apps/server && uv run pytest --ignore=tests/integration --tb=short -q",
    "test:server:slow": "cd apps/server && uv run pytest --durations=20 -q",
    "deploy:backend": "node deploy/scripts/remote-build-deploy.mjs",
    "deploy:backend:status": "node deploy/scripts/check-remote-build.mjs",
    "sync:logs": "bash scripts/sync-prod-logs.sh",
    "town:preview": "pnpm -C apps/desktop run shoot:simulation",
    "town:dev": "pnpm -C apps/desktop run dev:town",
    "town:install-ue": "powershell -ExecutionPolicy Bypass -File apps/town/scripts/install-ue.ps1",
    "town:build": "powershell -ExecutionPolicy Bypass -File apps/town/scripts/build-agenttown.ps1",
    "town:test": "powershell -ExecutionPolicy Bypass -File apps/town/scripts/test-agenttown.ps1",
    "town:shoot": "powershell -ExecutionPolicy Bypass -File apps/town/scripts/shoot-agenttown.ps1",
    "town:verify": "powershell -ExecutionPolicy Bypass -File apps/town/scripts/verify-unity.ps1",
    "town:open": "powershell -ExecutionPolicy Bypass -File apps/town/scripts/open-unity.ps1",
    "town:watch": "powershell -ExecutionPolicy Bypass -File apps/town/scripts/watch-ue-and-build.ps1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ],
    "overrides": {
      "@radix-ui/react-slot": "1.3.0",
      "esbuild": "^0.25.0",
      "js-yaml": "^4.2.0"
    }
  }
}
