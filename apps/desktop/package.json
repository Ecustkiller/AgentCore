{
  "name": "agentcore-desktop",
  "version": "0.3.1",
  "description": "AgentCore Desktop - Multi-Agent AI Workspace",
  "author": "AgentCore",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "shoot": "node scripts/shoot.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "bundle:sidecar": "node scripts/bundle-sidecar.mjs",
    "build:unpack": "pnpm bundle:sidecar && electron-vite build && electron-builder --dir",
    "build:win": "pnpm bundle:sidecar && electron-vite build && electron-builder --win",
    "build:win:cn": "node scripts/build-win-cn.mjs",
    "build:mac": "pnpm bundle:sidecar && electron-vite build && electron-builder --mac --arm64",
    "build:linux": "pnpm bundle:sidecar && electron-vite build && electron-builder --linux",
    "lint": "biome check src/ && node ../../scripts/check-ui-tokens.mjs --src apps/desktop/src/renderer",
    "lint:fix": "biome check --write src/",
    "check-ui-tokens": "node ../../scripts/check-ui-tokens.mjs --src apps/desktop/src/renderer",
    "test": "vitest",
    "conformance": "vitest run src/renderer/protocol",
    "typecheck": "tsc --noEmit",
    "postinstall": "node ./scripts/install-electron.mjs"
  },
  "dependencies": {
    "@agentcore/contract-rest-types": "workspace:*",
    "@agentcore/contract-types": "workspace:*",
    "@agentcore/design-tokens": "workspace:*",
    "@agentcore/protocol-conformance": "workspace:*",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-context-menu": "^2.3.1",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@tanstack/react-query": "^5.101.0",
    "@xyflow/react": "^12.0.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.8.9",
    "elkjs": "^0.9.0",
    "ignore": "^7.0.5",
    "jszip": "^3.10.1",
    "katex": "^0.17.0",
    "lucide-react": "^0.400.0",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "mermaid": "^11.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.0",
    "react-router-dom": "^7.17.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "vega-embed": "^7.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
