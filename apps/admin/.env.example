# Backend API origin the admin console calls. The server must allowlist this
# console's origin for credentialed CORS (config.cors_allow_origins). Defaults to
# http://localhost:8000 when unset.
# Production build uses .env.production (app.fashitianxia.xyz/api). Override via
# AGENTCORE_APP_API_URL / AGENTCORE_APP_HOST / AGENTCORE_OFFICE_HOST for
# deploy-production.mjs (loaded from deploy/.env.deploy.local).
VITE_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Optional: 发布通道探针（系统页「发布漂移」卡）
#
# Compares the desktop CDN's latest.json against what the website's download page
# advertises, fetched straight from the operator's browser. This is a *brand release*
# convenience, not a platform health signal — leave both unset (local dev, self-hosted
# deployments) and the card is hidden entirely with no cross-origin requests made.
# Both must be set; only one is treated as unconfigured, since there is nothing to
# compare against.
# ---------------------------------------------------------------------------
# VITE_RELEASE_CDN_LATEST_URL=https://<cdn-host>/desktop/latest.json
# VITE_RELEASE_DOWNLOAD_API_URL=https://<site-host>/api/download/latest
